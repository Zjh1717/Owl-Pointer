<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://example.org/wine#"
    xml:base="http://example.org/wine"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/wine"/>

  <owl:Class rdf:about="#Wine"/>
  <owl:Class rdf:about="#Winery"/>
  <owl:Class rdf:about="#Grape"/>
  <owl:Class rdf:about="#Region"/>

  <owl:ObjectProperty rdf:about="#madeFromGrape">
    <rdfs:domain rdf:resource="#Wine"/>
    <rdfs:range rdf:resource="#Grape"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasWinery">
    <rdfs:domain rdf:resource="#Wine"/>
    <rdfs:range rdf:resource="#Winery"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#locatedIn">
    <rdfs:domain rdf:resource="#Winery"/>
    <rdfs:range rdf:resource="#Region"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="#hasName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Wine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasYear">
    <rdfs:domain rdf:resource="#Wine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasFlavor">
    <rdfs:domain rdf:resource="#Wine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:NamedIndividual rdf:about="#chateau_margaux">
    <rdf:type rdf:resource="#Wine"/>
    <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chateau Margaux</hasName>
    <hasFlavor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blackcurrant</hasFlavor>
    <hasFlavor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cedar</hasFlavor>
    <madeFromGrape rdf:resource="#cabernet_sauvignon"/>
    <madeFromGrape rdf:resource="#merlot"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#chateau_lafite">
    <rdf:type rdf:resource="#Wine"/>
    <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chateau Lafite</hasName>
    <madeFromGrape rdf:resource="#cabernet_sauvignon"/>
    <hasWinery rdf:resource="#winery_lafite"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#cabernet_sauvignon">
    <rdf:type rdf:resource="#Grape"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#merlot">
    <rdf:type rdf:resource="#Grape"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#winery_lafite">
    <rdf:type rdf:resource="#Winery"/>
    <locatedIn rdf:resource="#bordeaux"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#bordeaux">
    <rdf:type rdf:resource="#Region"/>
  </owl:NamedIndividual>

</rdf:RDF>
